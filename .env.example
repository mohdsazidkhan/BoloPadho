# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (Atlas or local); the database name is the path part
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/BoloPadho

# Random string used to sign login tokens (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# AI answers through OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key
AI_BASE_URL=https://openrouter.ai/api/v1
# Models tried in order; any OpenRouter model ids work
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_MODEL1=meta-llama/llama-3.3-70b-instruct:free
AI_MODEL2=google/gemma-3-27b-it:free
AI_MODEL3=qwen/qwen-2.5-72b-instruct:free
AI_MODEL4=mistralai/mistral-small-3.1-24b-instruct:free
# Model used first when the question has a photo
AI_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=500

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Wallet & support (shown to learners)
CONTACT_EMAIL=support@example.com
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
WHATSAPP_CONTACT=+910000000000
NEXT_PUBLIC_WHATSAPP_CONTACT=+910000000000
EACH_CHAT_AU_TOKEN=10
NEXT_PUBLIC_EACH_CHAT_AU_TOKEN=10
NEXT_PUBLIC_AU_PER_RUPEE=10
WELCOME_AU_TOKENS=100
MINIMUM_RECHARGE=100
NEXT_PUBLIC_MINIMUM_RECHARGE=100

# Photo uploads (https://cloudinary.com/console)
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Admin login (/auth/login with these opens the admin panel)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
